# Required
ANTHROPIC_API_KEY=
# Only needed when the key above is organization-level (not created inside a workspace).
# Console -> Settings -> Workspaces -> copy the ID (wrkspc_...).
ANTHROPIC_WORKSPACE_ID=
BUFFER_ACCESS_TOKEN=
# GraphQL endpoint; only change if Buffer moves it.
BUFFER_API_URL=https://api.buffer.com
# Buffer downloads post images from a public URL, so the dashboard must be reachable from
# the internet when publishing. Locally: `cloudflared tunnel --url http://localhost:3000`
# and paste the https URL it prints. Later: the S3/CloudFront base.
PUBLIC_BASE_URL=

# Optional
# Nothing is scheduled for real until this is explicitly set to false.
TEST_MODE=true
DASHBOARD_PORT=3000
# Google reviews import (Reviews page). Google Cloud Console -> enable "Places API (New)" -> API key.
# GOOGLE_PLACE_ID: use "Find Place ID" on the Reviews page once the key is set.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Weekly digest. Leave SMTP_URL empty to write data/digests/<week>.html and log it.
# Ethereal test inbox: smtp://user:pass@smtp.ethereal.email:587 (create one at ethereal.email)
# AWS SES later: smtps://SMTP_USER:SMTP_PASS@email-smtp.us-east-1.amazonaws.com:465
SMTP_URL=
DIGEST_TO=
DIGEST_FROM=
# none | gemini | openai  (backgrounds only, off by default)
IMAGE_GEN_PROVIDER=none
# Weekly run aborts if projected cost exceeds this (pipeline-spec guardrails).
COST_CEILING_USD=2.00
