{
  "name": "Daedabyte Web Solutions",
  "url": "https://daedabyte.com/",
  "industry": "web design",
  "kind": "own",
  "permissionToName": true,
  "recipe": {
    "dismiss": [
      "button:has-text('Accept')",
      "[aria-label='Close']"
    ],
    "waitFor": [
      "body"
    ],
    "settleMs": 1000,
    "sections": [
      {
        "name": "hero",
        "selector": "main section, main > div, section, header + div"
      },
      {
        "name": "services",
        "selector": "main section:nth-of-type(2), section:nth-of-type(2)"
      }
    ]
  }
}
